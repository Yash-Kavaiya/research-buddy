# All optional. The app needs no server-side secrets: model keys come from each user's browser.

# Contact email for the OpenAlex and Crossref polite pools (higher rate limits for literature search).
OPENALEX_MAILTO=

# Chat requests allowed per client address per minute, per serverless instance.
RATE_LIMIT_REQUESTS=30

# Comma-separated origins allowed to call the API from another site. Leave empty when the
# site and the API share an origin, which is how the Vercel deployment works.
ALLOWED_ORIGINS=
